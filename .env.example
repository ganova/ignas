APP_NAME="Ignas.studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker compose ships PostgreSQL by default. If only MySQL/MariaDB is
# available, switch DB_CONNECTION to mysql and adjust DB_PORT to 3306.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ignas
DB_USERNAME=ignas
DB_PASSWORD=ignas

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=ignas

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is only needed for password-reset emails. Leave as "log" until a
# real mailer is configured; the forgot-password flow is not exposed
# until this is set to a working driver in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@ignas.studio"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage (optional). Leave blank to keep using local/public disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Set to true only when the `ssr` docker service (or `php artisan
# inertia:start-ssr` after `npm run build:ssr`) is actually running —
# otherwise every request pays the SSR-gateway connection timeout.
INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

# First admin account. Used only by `php artisan db:seed --class=AdminUserSeeder`.
# If ADMIN_PASSWORD is left blank, a random password is generated and printed
# once to the console output — it is never written to a file or logged again.
ADMIN_EMAIL=admin@ignas.studio
ADMIN_PASSWORD=
